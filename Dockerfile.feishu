FROM node:22-bookworm-slim AS build

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . ./
ARG VITE_MAPBOX_TOKEN=""
ENV VITE_MAPBOX_TOKEN=$VITE_MAPBOX_TOKEN
RUN npm run build

FROM node:22-bookworm-slim AS runtime

ENV NODE_ENV=production \
    API_PORT=3009 \
    FEISHU_DATA_DIR=/data/feishu
WORKDIR /app
RUN useradd --create-home --uid 10001 --shell /usr/sbin/nologin pocketearth \
    && mkdir -p /data/feishu \
    && chown -R pocketearth:pocketearth /data/feishu
COPY --from=build --chown=pocketearth:pocketearth /app/dist ./dist
COPY --chown=pocketearth:pocketearth server.mjs ./server.mjs
COPY --chown=pocketearth:pocketearth server ./server
COPY --chown=pocketearth:pocketearth knowledge/travel-place-sources.mjs ./knowledge/travel-place-sources.mjs
USER pocketearth
EXPOSE 3009
VOLUME ["/data/feishu"]
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:3009/healthz').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"
CMD ["node", "server.mjs"]
