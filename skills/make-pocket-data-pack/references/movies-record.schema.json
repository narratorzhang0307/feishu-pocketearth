{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pocket.earth/schemas/pocket-data-v1/movies-record.schema.json",
  "title": "Pocket Movies Record v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "original", "type", "director", "country", "year", "rating", "date", "synopsis"],
  "properties": {
    "id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "title": { "type": "string", "minLength": 1, "maxLength": 300 },
    "original": { "type": "string", "maxLength": 300 },
    "type": { "type": "string", "maxLength": 120 },
    "director": { "type": "string", "maxLength": 300 },
    "country": { "type": "string", "maxLength": 120 },
    "year": { "type": ["integer", "null"], "minimum": 0, "maximum": 3000 },
    "rating": { "type": ["number", "null"], "minimum": 0, "maximum": 5 },
    "publicRating": { "type": ["number", "null"], "minimum": 0, "maximum": 10 },
    "date": { "type": "string", "pattern": "^(?:|[0-9]{4}-[0-9]{2}-[0-9]{2})$" },
    "synopsis": { "type": "string", "maxLength": 4000 },
    "locations": {
      "type": "array",
      "maxItems": 20,
      "items": { "$ref": "#/$defs/location" }
    }
  },
  "$defs": {
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "place", "lng", "lat", "confidence"],
      "properties": {
        "kind": { "enum": ["filming", "story", "country"] },
        "place": { "type": "string", "minLength": 1, "maxLength": 200 },
        "lng": { "type": "number", "minimum": -180, "maximum": 180 },
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  }
}
