# 将本文件另存为 .env，并按需要填写对应服务配置。所有密钥只由服务端读取。

# Mapbox access token（地图底图）。申请：https://account.mapbox.com/access-tokens/
VITE_MAPBOX_TOKEN=your_mapbox_access_token_here

# ——— 底图 provider 开关：mapbox（默认）| amap（高德）———
# 切到高德：设为 amap；回退 Mapbox：删掉此行或设回 mapbox（零代码改动）。
VITE_MAP_PROVIDER=mapbox
# 高德地图 key（Web端 JS API）。申请：https://console.amap.com/dev/key/app
#   应用管理 → 创建新应用 → 添加 Key → 服务平台选「Web端(JS API)」→ 拿到 key + 安全密钥。
VITE_AMAP_KEY=your_amap_web_jsapi_key_here
# 高德安全密钥（JSAPI 2.0 必填，与 key 同页获取）
VITE_AMAP_SECURITY_JSCODE=your_amap_security_jscode_here
# 高德底图样式（可选）：amap://styles/dark（默认）| light | normal | grey | whitesmoke
VITE_AMAP_STYLE=amap://styles/dark

# ——— 阿里云百炼 Qwen 云端推理（唯一云模型链路）———
# 仅服务端读取，绝不能使用 VITE_ 前缀。API Key 在百炼控制台创建。
# 文本/JSON/流式走 OpenAI-compatible 接口；Qwen Image 走百炼原生同步接口。
API_PORT=3009
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_NATIVE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
QWEN_MODEL=qwen-plus
QWEN_MODEL_COUNCIL=qwen3.5-plus
QWEN_MODEL_NARRATIVE=qwen-plus
QWEN_MODEL_ROUTE=qwen-flash
QWEN_MODEL_MULTILINGUAL=qwen-plus
QWEN_SEARCH_MODEL=qwen3.5-plus
QWEN_PLACE_MODEL=qwen-plus
QWEN_IMAGE_MODEL=qwen-image-2.0
# 看展搭子云端补全与用户主动触发的展签视觉兜底；核心识别仍优先走端侧 Qwen/MNN。
QWEN_EXHIBITION_MODEL=qwen-plus
QWEN_VISION_MODEL=qwen3-vl-plus
# 公开演示的云端费用保护：按 IP 限制 Qwen/地点资料端点。仅在 nginx 反代已覆盖源站时开启 TRUST_PROXY。
TRUST_PROXY=true
CLOUD_RATE_LIMIT_PER_MINUTE=24

# ——— 飞书 AI 绝活大会：企业自建应用 + Web App + 回写 ———
# App Secret、Verification Token、Encrypt Key 严禁使用 VITE_ 前缀。
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=
# 必须是飞书可访问的公网 HTTPS 地址；消息卡片会用它打开审核台/知识地图。
FEISHU_WEB_BASE_URL=https://your-pocket-earth.example.com
# 可选：把结果文档放到指定文件夹；把逐地点记录批量写入指定多维表格。
FEISHU_DOCUMENT_FOLDER_TOKEN=
FEISHU_BITABLE_APP_TOKEN=
FEISHU_BITABLE_TABLE_ID=
# PaddleOCR / PP-Structure 服务契约见 docs/feishu/部署与上手指南.md。
PADDLE_OCR_URL=http://127.0.0.1:8010/v1/ocr
PADDLE_OCR_API_KEY=
OCR_DEVICE=cpu
OCR_MAX_BYTES=18874368
OCR_MAX_PAGES=30
OCR_CONCURRENCY=1
# Compose 暴露主服务的宿主机端口；公网 HTTPS 反代到这里。
POCKET_EARTH_PORT=3009
FEISHU_WORKFLOW_VERSION=feishu-p0-v1
FEISHU_MAX_UPLOAD_BYTES=18874368
FEISHU_TASK_RATE_LIMIT_PER_MINUTE=6
# 仅本地浏览器验收可开启；比赛/生产部署必须为 false。
FEISHU_DEV_BYPASS_AUTH=false
# 仅自动化测试或受控迁移可开启；比赛演示必须使用真实文件和真实 OCR。
FEISHU_ALLOW_PREEXTRACTED_OCR=false

# ——— 旅行规划 Skill：Qwen3-VL-2B + 分离式 Travel Planner LoRA（MNN）———
# 同一个 MNN sidecar 也承载看展搭子的 Qwen3-VL、铭文 LoRA 与展品抠图专项模型。
# 未连接时 UI 会如实显示端侧未就绪，不会用 Gemma、云模型或 Qwen Base 冒充已安装的 LoRA Skill。
EDGE_BACKEND=mnn
MNN_URL=http://127.0.0.1:8000
EDGE_MODEL=qwen3:0.6b
EDGE_VISION_MODEL=qwen2.5vl:3b
# sidecar 需提供 /v1/chat、/v1/exhibit-matting、/v1/assets，并加载：
# Qwen3-VL-2B 同版基座、travel-planner、rubbing-vision 以及 exhibit-matting 专项模型。
# 旅行 LoRA 完整哈希见 public/models/travel-planner/manifest.json；展品抠图模型由 MNN 资产接口按需安装。

# ——— 看展搭子：可选自有 GPU 3D Gaussian Splatting 服务 ———
# 留空时保留端侧 2.5D（展品抠图 + Depth Anything V2 + 确定性 Builder）；配置后才出现高清 3D 提交入口。
VITE_EXHIBIT_3DGS_API_URL=

# ——— Pocket Data Pack v1（书籍/电影/音乐按需加载；可替换为 OSS 不可变 Manifest URL）———
# 留空时使用代码内置的不可变版本；本地离线开发时可改回 /data-packs/...。
VITE_BOOKS_DATA_PACK_URL=https://last-night-on-earth.oss-cn-hangzhou.aliyuncs.com/pocket-earth/data-packs/releases/20260810-books-movies-v1/pocket-earth-books/1.0.0/manifest.json
VITE_MOVIES_DATA_PACK_URL=https://last-night-on-earth.oss-cn-hangzhou.aliyuncs.com/pocket-earth/data-packs/releases/20260810-books-movies-v1/pocket-earth-movies/1.0.0/manifest.json
VITE_MUSIC_DATA_PACK_URL=https://last-night-on-earth.oss-cn-hangzhou.aliyuncs.com/pocket-earth/data-packs/releases/20260810-music-v1/pocket-earth-music/1.0.0/manifest.json

# ——— 可选旧 3D 云重建（决赛版默认关闭，避免额外境外账号/计费依赖）———
# VITE_ENABLE_KIRI_CLOUD=true
# BYOK（自带 key）：服务端【不再】从 env 读 KIRI key，改由用户在应用内输入自己的 key（只存其本机浏览器，
# 随 x-kiri-key 头传给 /api/kiri 代理）。这样公开部署也不会被陌生人消耗你的额度。
# 注册开发者拿 token：kiriengine.app（新号 10 免费 credit，1 scan≈$1）。不设也不影响 3D 手动导入 + 示例。
# （此项已废弃，保留仅作说明；设了也不会被服务端使用。）
# KIRI_API_KEY=

# ── 旅行 agent 增强（都可留空，留空只影响对应增强、深链兜底照常）──
# Amadeus Self-Service（免费注册 developers.amadeus.com → My Apps 拿 API Key/Secret）：
# 填了才显示机票「参考价」（test 环境缓存数据，页面已明示以跳转页为准）。
AMADEUS_KEY=
AMADEUS_SECRET=
