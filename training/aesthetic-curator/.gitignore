# Downloaded upstream repositories and raw datasets
sources/
raw/
normalized/
contact-sheets/
staging/
bundles/
pai/artifacts/
.tools/
.model-cache/

# Model and run artifacts
runs/**/checkpoints/
runs/**/*.safetensors
runs/**/*.bin
runs/**/*.pt
