runs/**/*.mnn

# Private evaluation images never enter Git
eval/private/

# Keep auditable metadata and placeholders
!sources/.gitkeep
!raw/.gitkeep
!normalized/.gitkeep
!contact-sheets/.gitkeep
!staging/.gitkeep
!bundles/.gitkeep
!pai/artifacts/.gitkeep
!eval/private/.gitkeep
