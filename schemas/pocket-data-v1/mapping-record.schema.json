{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pocket.earth/schemas/pocket-data-v1/mapping-record.schema.json",
  "title": "Pocket Content Mapping Record v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "author", "era", "city", "sourceName", "sourceSha256", "summary", "locations"],
  "properties": {
    "id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "title": { "type": "string", "minLength": 1, "maxLength": 300 },
    "author": { "type": "string", "maxLength": 300 },
    "era": { "type": "string", "maxLength": 160 },
    "city": { "type": "string", "maxLength": 160 },
    "sourceName": { "type": "string", "minLength": 1, "maxLength": 500 },
    "sourceSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "summary": { "type": "string", "maxLength": 4000 },
    "locations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": { "$ref": "#/$defs/location" }
    }
  },
  "$defs": {
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "status", "relation", "page", "quote", "note", "lng", "lat", "confidence", "confirmed"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "name": { "type": "string", "minLength": 1, "maxLength": 300 },
        "status": { "enum": ["extant", "rebuilt", "memory-only"] },
        "relation": { "enum": ["scene", "mentioned", "route", "subject"] },
        "page": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "quote": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "note": { "type": "string", "maxLength": 2000 },
        "lng": { "type": "number", "minimum": -180, "maximum": 180 },
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "confirmed": { "const": true },
        "sourceRef": { "type": "string", "maxLength": 500 },
        "sourceUrls": { "type": "array", "maxItems": 8, "items": { "type": "string", "pattern": "^https://" } }
      }
    }
  }
}
