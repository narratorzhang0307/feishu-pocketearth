{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pocket.earth/schemas/pocket-data-v1/manifest.schema.json",
  "title": "Pocket Data Pack v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "identity",
    "schema",
    "compatibility",
    "privacy",
    "provenance",
    "distribution"
  ],
  "properties": {
    "protocol": { "const": "pocket-data/v1" },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "version", "author", "description"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)+$", "maxLength": 128 },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$" },
        "author": { "type": "string", "minLength": 1, "maxLength": 120 },
        "description": { "type": "string", "maxLength": 500 }
      }
    },
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "record_count"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*/v[1-9][0-9]*$",
          "maxLength": 128
        },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$" },
        "record_count": { "type": "integer", "minimum": 0, "maximum": 50000 }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["skills", "runtime_min"],
      "properties": {
        "skills": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)+$",
            "maxLength": 128
          }
        },
        "runtime_min": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }
      }
    },
    "privacy": { "enum": ["public", "private", "restricted"] },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "license", "generated_at"],
      "properties": {
        "source": { "type": "string", "minLength": 1, "maxLength": 500 },
        "license": { "type": "string", "minLength": 1, "maxLength": 120 },
        "generated_at": { "type": "string", "format": "date-time" }
      }
    },
    "distribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": { "enum": ["inline", "chunked"] }
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "path", "media_type", "bytes", "sha256", "records"],
        "properties": {
          "role": { "const": "records" },
          "path": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$" },
          "media_type": { "const": "application/json" },
          "bytes": { "type": "integer", "minimum": 2, "maximum": 52428800 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "records": { "type": "integer", "minimum": 0, "maximum": 10000 }
        }
      }
    },
    "records": {
      "type": "array",
      "maxItems": 50000,
      "items": { "type": "object" }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "distribution": { "properties": { "mode": { "const": "inline" } } } } },
      "then": { "required": ["records"] }
    },
    {
      "if": { "properties": { "distribution": { "properties": { "mode": { "const": "chunked" } } } } },
      "then": { "required": ["files"] }
    }
  ]
}
