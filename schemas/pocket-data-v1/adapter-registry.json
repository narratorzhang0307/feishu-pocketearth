{
  "protocol": "pocket-data/v1",
  "runtime": "Pocket Earth",
  "runtime_version": "1.0.0",
  "rule": "Core protocol validates the package envelope; an installed adapter validates records and connects them to a Skill.",
  "adapters": [
    {
      "domain": "books",
      "skill_id": "pocket.books",
      "schema_name": "pocket.books/v1",
      "schema_version": "1.0.0",
      "record_schema": "books-record.schema.json",
      "agent_target": "books-agent",
      "feishu_table_env": "FEISHU_BITABLE_BOOKS_TABLE_ID",
      "status": "installed"
    },
    {
      "domain": "movies",
      "skill_id": "pocket.movies",
      "schema_name": "pocket.movies/v1",
      "schema_version": "1.0.0",
      "record_schema": "movies-record.schema.json",
      "agent_target": "movies-agent",
      "feishu_table_env": "FEISHU_BITABLE_MOVIES_TABLE_ID",
      "status": "installed"
    },
    {
      "domain": "music",
      "skill_id": "pocket.music",
      "schema_name": "pocket.music/v1",
      "schema_version": "1.0.0",
      "record_schema": "music-city-record.schema.json",
      "agent_target": "music-agent",
      "feishu_table_env": "FEISHU_BITABLE_MUSIC_TABLE_ID",
      "status": "installed"
    },
    {
      "domain": "photos",
      "skill_id": "pocket.photos",
      "schema_name": "pocket.photos/v1",
      "schema_version": "1.0.0",
      "record_schema": "photos-record.schema.json",
      "agent_target": "photos-agent",
      "feishu_table_env": "FEISHU_BITABLE_PHOTOS_TABLE_ID",
      "status": "installed"
    },
    {
      "domain": "mapping",
      "skill_id": "pocket.mapping",
      "schema_name": "pocket.mapping/v1",
      "schema_version": "1.0.0",
      "record_schema": "mapping-record.schema.json",
      "status": "installed"
    }
  ]
}
