{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pocket.earth/schemas/pocket-data-v1/photos-record.schema.json",
  "title": "Pocket Photos Record v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "city", "date", "lat", "lng", "thumbnailUrl", "contentHash", "summary"],
  "properties": {
    "id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "title": { "type": "string", "minLength": 1, "maxLength": 300 },
    "city": { "type": "string", "maxLength": 200 },
    "date": { "type": "string", "pattern": "^(?:|[0-9]{4}-[0-9]{2}-[0-9]{2})$" },
    "lat": { "type": ["number", "null"], "minimum": -90, "maximum": 90 },
    "lng": { "type": ["number", "null"], "minimum": -180, "maximum": 180 },
    "thumbnailUrl": { "type": "string", "pattern": "^(?:|https://.*)$", "maxLength": 2000 },
    "contentHash": { "type": "string", "maxLength": 256 },
    "summary": { "type": "string", "maxLength": 4000 }
  }
}
