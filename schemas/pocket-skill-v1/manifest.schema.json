{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pocket.earth/schemas/pocket-skill-v1/manifest.schema.json",
  "title": "Pocket Skill Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "identity", "kind", "entry", "runtime", "permissions", "data", "quality_gate", "fallback", "evaluation", "distribution", "assets", "provenance"],
  "properties": {
    "protocol": { "const": "pocket-skill/v1" },
    "identity": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "version", "author", "description"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)+$", "maxLength": 128 },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+][0-9A-Za-z.-]+)?$" },
        "author": { "type": "string", "minLength": 1, "maxLength": 120 },
        "description": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    },
    "kind": { "enum": ["markdown", "lora", "hybrid"] },
    "entry": {
      "type": "object", "additionalProperties": false, "required": ["target"],
      "properties": {
        "target": { "type": "string", "minLength": 1, "maxLength": 128 },
        "instructions": { "type": "string", "minLength": 1, "maxLength": 128 },
        "adapter": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "runtime": {
      "type": "object", "additionalProperties": false, "required": ["execution", "runtime_min", "platforms"],
      "properties": {
        "execution": { "enum": ["declarative", "mnn"] },
        "runtime_min": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "platforms": { "type": "array", "uniqueItems": true, "items": { "enum": ["web", "android-arm64"] } },
        "base": {
          "type": "object", "additionalProperties": false, "required": ["id", "revision", "sha256"],
          "properties": {
            "id": { "type": "string", "minLength": 1, "maxLength": 160 },
            "revision": { "type": "string", "minLength": 1, "maxLength": 160 },
            "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
          }
        }
      }
    },
    "permissions": {
      "type": "object", "additionalProperties": false, "required": ["scopes", "tools", "network_hosts"],
      "properties": {
        "scopes": { "type": "array", "uniqueItems": true, "items": { "enum": ["location", "photos", "audio", "network", "clipboard", "public-sources"] } },
        "tools": { "type": "array", "uniqueItems": true, "items": { "enum": ["enrich", "geocode", "edge_tag", "mark_place", "data_pack", "vision", "restore"] } },
        "network_hosts": { "type": "array", "uniqueItems": true, "maxItems": 20, "items": { "type": "string", "pattern": "^(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]{2,63}$" } }
      }
    },
    "data": {
      "type": "object", "additionalProperties": false, "required": ["schemas"],
      "properties": { "schemas": { "type": "array", "uniqueItems": true, "maxItems": 20, "items": { "type": "string", "maxLength": 128 } } }
    },
    "quality_gate": {
      "type": "object", "additionalProperties": false, "required": ["policy_id", "checks"],
      "properties": {
        "policy_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "checks": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "type": "string", "minLength": 1, "maxLength": 200 } }
      }
    },
    "fallback": {
      "type": "object", "additionalProperties": false, "required": ["order"],
      "properties": {
        "order": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["adapter", "base", "rules", "user-confirmation", "stop"] }, "contains": { "const": "stop" } }
      }
    },
    "evaluation": {
      "type": "object", "additionalProperties": false, "required": ["suite", "passed", "score", "threshold", "tested_at"],
      "properties": {
        "suite": { "type": "string", "minLength": 1, "maxLength": 160 },
        "passed": { "type": "boolean" },
        "score": { "type": "number", "minimum": 0, "maximum": 1 },
        "threshold": { "type": "number", "minimum": 0, "maximum": 1 },
        "tested_at": { "type": "string", "format": "date-time" }
      }
    },
    "distribution": {
      "type": "object", "additionalProperties": false, "required": ["channel", "manifest_url", "uninstall_policy"],
      "properties": {
        "channel": { "enum": ["builtin", "oss", "private"] },
        "manifest_url": { "type": "string", "pattern": "^(?:|https://)" },
        "uninstall_policy": { "const": "remove-skill-assets-keep-private-data" }
      }
    },
    "assets": {
      "type": "array", "maxItems": 100,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "role", "media_type", "bytes", "sha256", "url"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)+$" },
          "role": { "enum": ["instructions", "adapter", "model", "example", "avatar", "other"] },
          "media_type": { "type": "string", "minLength": 1, "maxLength": 120 },
          "bytes": { "type": "integer", "minimum": 0, "maximum": 8589934592 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "url": { "type": "string", "pattern": "^(?:|https://)" },
          "optional": { "type": "boolean" }
        }
      }
    },
    "provenance": {
      "type": "object", "additionalProperties": false, "required": ["source", "license", "released_at"],
      "properties": {
        "source": { "type": "string", "minLength": 1, "maxLength": 500 },
        "license": { "type": "string", "minLength": 1, "maxLength": 120 },
        "released_at": { "type": "string", "format": "date-time" }
      }
    },
    "signature": {
      "type": "object", "additionalProperties": false, "required": ["algorithm", "key_id", "value"],
      "properties": {
        "algorithm": { "const": "ed25519" },
        "key_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "value": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "markdown" } } },
      "then": { "properties": { "runtime": { "properties": { "execution": { "const": "declarative" } } } } }
    },
    {
      "if": { "properties": { "kind": { "enum": ["lora", "hybrid"] } } },
      "then": {
        "properties": {
          "entry": { "required": ["adapter"] },
          "runtime": { "required": ["base"], "properties": { "execution": { "const": "mnn" } } }
        }
      }
    }
  ]
}
